# --- LLM providers (not needed for M1) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_REDACT_PII=true

# --- runtime ---
SCHEDULER_MODE=local
DB_URL=sqlite:///~/.trackboard/app.db
TZ=Asia/Kolkata

# --- auth ---
CRON_SECRET=change-me-too
SITE_URL=https://athena-phi-one.vercel.app
INSECURE_COOKIES=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me
ALLOWED_EMAILS=you@example.com
OWNER_EMAIL=you@example.com
DEV_USER_EMAIL=you@example.com
CONTACT_EMAIL=you@example.com

# --- content sources (M1: YouTube only) ---
YOUTUBE_API_KEY=

# --- email / digest delivery (BUILD_SPEC §8.9) ---
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=


# --- hosted database (production). Leave empty to use the local SQLite file. ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
