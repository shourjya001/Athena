# --- LLM providers (not needed for M1) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_REDACT_PII=true

# --- runtime ---
SCHEDULER_MODE=local
DB_URL=sqlite:///~/.trackboard/app.db
TZ=Asia/Kolkata

# --- auth (M1 uses DEV_USER_EMAIL until OAuth lands) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me
ALLOWED_EMAILS=you@example.com
OWNER_EMAIL=you@example.com
DEV_USER_EMAIL=you@example.com
CONTACT_EMAIL=you@example.com

# --- content sources (M1: YouTube only) ---
YOUTUBE_API_KEY=

# --- email / digest delivery (BUILD_SPEC §8.9) ---
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shourjya001@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=shourjya001@gmail.com

